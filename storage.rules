rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function userPath() {
      return /databases/(default)/documents/users/$(email());
    }

    function enabledUser() {
      return signedIn()
        && firestore.exists(userPath())
        && firestore.get(userPath()).data.enabled == true;
    }

    function manager() {
      return enabledUser()
        && firestore.get(userPath()).data.role == 'manager';
    }

    match /vouchers/{planId}/{ownerEmail}/{unique}/{fileName} {
      allow read: if enabledUser();

      allow create, update: if enabledUser()
        && (manager() || ownerEmail == email())
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/.*)');

      allow delete: if enabledUser()
        && (manager() || ownerEmail == email());
    }
  }
}
