rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Permanent bootstrap account for budget permission synchronization.
    // This prevents the users collection from locking out the primary manager
    // if their own users document is temporarily missing or changed during testing.
    function primaryManager() {
      return signedIn() && email() == 'master004400@gmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(email()));
    }

    function enabledUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(email()))
        && userDoc().data.enabled == true;
    }

    function manager() {
      return primaryManager()
        || (enabledUser() && userDoc().data.role == 'manager');
    }

    function recordLocked() {
      return resource.data.get('reviewStatus', 'pending') == 'approved'
        || resource.data.get('reviewed', false) == true
        || resource.data.get('locked', false) == true;
    }

    function amountConfirmed(data) {
      return data.get('amountConfirmed', false) == true
        || data.get('amountManuallyConfirmed', false) == true
        || data.get('amountConfirmedByManagerWaiver', false) == true;
    }

    function hasVoucher(data) {
      return data.get('voucherUrl', '') != ''
        || data.get('folderUrl', '') != '';
    }

    function voucherWaived(data) {
      return data.get('voucherNotRequired', false) == true
        || data.get('voucherRequirementWaived', false) == true;
    }

    function voucherWaiverRequested(data) {
      return data.get('voucherNotRequiredRequested', false) == true;
    }

    function submissionComplete(data) {
      return data.get('estimated', false) == true
        || voucherWaiverRequested(data)
        || (
          amountConfirmed(data)
          && (
            (data.get('archived', false) == true && hasVoucher(data))
            || voucherWaived(data)
          )
        );
    }

    function linked(data) {
      return data.get('advanceAllocationId', '') != '';
    }
    function adjustmentApproval() {
      let before = resource.data.get('actualAdjustment', {});
      let after = request.resource.data.get('actualAdjustment', {});
      return manager()
        && before.get('status', '') == 'pending'
        && after.get('status', '') == 'approved'
        && after.get('amount', -1) == before.get('amount', -2)
        && after.get('requestedBy', '') == before.get('requestedBy', '')
        && after.get('reviewedBy', '') == email()
        && request.resource.data.amount == before.amount
        && request.resource.data.estimated == false
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.settlementAmount == before.amount;
    }
    function refundAmountApproval() {
      let a = get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      let after = getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      return manager() && a.get('refundReported', false) == true
        && a.get('refundReceivedConfirmed', false) == false
        && after.get('refundReceivedConfirmed', false) == true
        && after.refundReceivedBy == email()
        && after.refundAmount == a.refundAmount
        && request.resource.data.amount == a.estimatedAmount - a.refundAmount;
    }
    function allocationCancellation() {
      return manager()
        && request.resource.data.get('advanceAllocationId', '') == ''
        && request.resource.data.amount == resource.data.amount
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.get('deleted', false) == true;
    }
    function linkedRecordProtected() {
      return !linked(resource.data) || allocationCancellation() || (
        request.resource.data.get('advanceAllocationId', '') == resource.data.advanceAllocationId
        && request.resource.data.get('advanceBatchId', '') == resource.data.get('advanceBatchId', '')
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.categoryId == resource.data.categoryId
        && request.resource.data.semester == resource.data.semester
        && request.resource.data.get('originalEstimatedAmount', 0) == resource.data.get('originalEstimatedAmount', 0)
        && (request.resource.data.amount == resource.data.amount || adjustmentApproval() || refundAmountApproval())
        && (request.resource.data.get('estimated', false) == resource.data.get('estimated', false) || adjustmentApproval() || (request.resource.data.get('estimated', true) == false && amountConfirmed(request.resource.data) && hasVoucher(request.resource.data) && request.resource.data.get('archived', false) == true))
      );
    }
    function adjustmentProtected() {
      let before = resource.data.get('actualAdjustment', {});
      let after = request.resource.data.get('actualAdjustment', {});
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['actualAdjustment'])
        || (
          linked(resource.data)
          && before.get('status', '') in ['', 'rejected']
          && after.keys().hasOnly(['status','amount','reason','requestedBy','requestedAt'])
          && after.status == 'pending'
          && after.amount is number && after.amount >= 0
          && after.amount <= get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.estimatedAmount
          && after.reason is string && after.reason.size() > 0 && after.reason.size() <= 300
          && after.requestedBy == email() && after.requestedAt == request.time
          && request.resource.data.estimated == true
          && request.resource.data.amountConfirmed == true && hasVoucher(request.resource.data)
        )
        || (manager() && before.get('status', '') == 'pending' && (
          adjustmentApproval()
          || (after.status == 'cancelled' && refundAmountApproval())
          || (after.status == 'rejected' && after.amount == before.amount
            && after.requestedBy == before.requestedBy && after.reviewedBy == email()
            && request.resource.data.amount == resource.data.amount)
        ));
    }
    function allocationFixed() {
      return request.resource.data.estimatedAmount == resource.data.estimatedAmount
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.expenseRecordId == resource.data.expenseRecordId
        && request.resource.data.batchId == resource.data.batchId;
    }
    function refundOwed() {
      return resource.data.get('allocationReceivedConfirmed', false) == true
        && request.resource.data.get('refundAmount', 0) is int
        && request.resource.data.refundAmount > 0
        && request.resource.data.refundAmount <= resource.data.estimatedAmount;
    }
    function teacherRefundReport() {
      return enabledUser() && resource.data.ownerEmail == email()
        && resource.data.get('refundReported', false) == false
        && resource.data.get('refundReceivedConfirmed', false) == false
        && request.resource.data.refundReported == true
        && request.resource.data.refundReportedBy == email()
        && request.resource.data.refundReportedAt == request.time
        && refundOwed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'refundReported','refundAmount','refundReportedBy','refundReportedAt','updatedAt','updatedBy'
        ]);
    }
    function refundReceiptProtected() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['refundReceivedConfirmed','refundReceivedBy','refundReceivedAt'])
        || (manager() && resource.data.get('refundReported', false) == true
          && resource.data.get('refundReceivedConfirmed', false) == false
          && request.resource.data.refundReceivedConfirmed == true
          && request.resource.data.refundReceivedBy == email()
          && request.resource.data.refundReceivedAt == request.time
          && request.resource.data.refundAmount == resource.data.refundAmount && refundOwed()
          && getAfter(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data.amount == resource.data.estimatedAmount - resource.data.refundAmount);
    }

    match /users/{userEmail} {
      allow read: if manager()
        || (enabledUser() && userEmail == email());
      allow create, update, delete: if manager();
    }

    match /budgetPlans/{planId} {
      allow read: if enabledUser();
      allow create, update, delete: if manager();
    }

    match /budgetCategories/{categoryId} {
      allow read: if enabledUser();
      allow create, update, delete: if manager();
    }

    // Advance/disbursement batches remain manager-managed, but enabled users may read
    // the batch metadata needed to understand their own allocations.
    match /advanceBatches/{batchId} {
      allow read: if enabledUser();
      allow create, update, delete: if manager();
    }

    // Managers manage all allocations. Regular users may read only their own allocation
    // and may only confirm that the allocated amount was received.
    match /advanceAllocations/{allocationId} {
      allow read: if manager()
        || (enabledUser() && resource.data.ownerEmail == email());

      allow create, delete: if manager();

      allow update: if allocationFixed() && refundReceiptProtected() && (
        manager()
        || teacherRefundReport()
        || (
          enabledUser()
          && resource.data.ownerEmail == email()
          && resource.data.get('allocationReceivedConfirmed', false) == false
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.get('allocationReceivedConfirmed', false) == true
          && request.resource.data.get('allocationReceivedBy', '') == email()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'allocationReceivedConfirmed',
            'allocationReceivedAt',
            'allocationReceivedBy',
            'updatedAt',
            'updatedBy'
          ])
        ));
    }

    // Reminder configuration and reminder history are manager-only.
    match /reminderSettings/{planId} {
      allow read, create, update, delete: if manager();
    }

    match /reminderLogs/{logId} {
      allow read, create: if manager();
      allow update, delete: if false;
    }

    match /expenseRecords/{recordId} {
      allow read: if enabledUser();

      allow create: if enabledUser()
        && request.resource.data.get('reviewStatus', 'pending') != 'approved'
        && request.resource.data.get('reviewed', false) == false
        && request.resource.data.get('locked', false) == false
        && (
          (
            manager()
            && request.resource.data.createdBy == email()
            && submissionComplete(request.resource.data)
          )
          || (
            !manager()
            && request.resource.data.ownerEmail == email()
            && request.resource.data.createdBy == email()
            && !voucherWaived(request.resource.data)
            && submissionComplete(request.resource.data)
          )
        );

      allow update: if enabledUser() && linkedRecordProtected() && adjustmentProtected()
        && (manager() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['actualAdjustmentHistory', 'refundAdjustment'])) && (
        manager()
        || (
          resource.data.ownerEmail == email()
          && !recordLocked()
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.get('reviewStatus', 'pending') != 'approved'
          && request.resource.data.get('reviewed', false) == false
          && request.resource.data.get('locked', false) == false
          && request.resource.data.get('voucherNotRequired', false) == resource.data.get('voucherNotRequired', false)
          && request.resource.data.get('voucherRequirementWaived', false) == resource.data.get('voucherRequirementWaived', false)
          && request.resource.data.get('amountConfirmedByManagerWaiver', false) == resource.data.get('amountConfirmedByManagerWaiver', false)
          && submissionComplete(request.resource.data)
        )
      );

      allow delete: if enabledUser() && !linked(resource.data) && (
        manager()
        || (
          resource.data.ownerEmail == email()
          && !recordLocked()
        )
      );
    }

    match /auditLogs/{logId} {
      allow read: if manager();
      allow create: if manager();
      allow update, delete: if false;
    }
  }
}
