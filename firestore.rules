rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Permanent bootstrap account for budget permission synchronization.
    // This prevents the users collection from locking out the primary manager
    // if their own users document is temporarily missing or changed during testing.
    function primaryManager() {
      return signedIn() && email() == 'master004400@gmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(email()));
    }

    function enabledUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(email()))
        && userDoc().data.enabled == true;
    }

    function manager() {
      return primaryManager()
        || (enabledUser() && userDoc().data.role == 'manager');
    }

    // 預支承辦人僅可操作本人批次與本人分配，並保留一般使用者權限。
    function advanceOfficer() {
      return enabledUser() && userDoc().data.role == 'advance';
    }
    function ownBatch(data) {
      return advanceOfficer() && data.handlerEmail == email();
    }
    function ownAllocation(data) {
      return advanceOfficer() && data.ownerEmail == email()
        && get(/databases/$(database)/documents/advanceBatches/$(data.batchId)).data.handlerEmail == email();
    }
    function refundReviewer(data) {
      return manager() || (advanceOfficer() && data.ownerEmail == email());
    }
    function ownRecordServiceUpdate() {
      return advanceOfficer() && resource.data.ownerEmail == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount','refundAdjustment','actualAdjustment','advanceBatchId','advanceAllocationId','advanceLinked','updatedAt','updatedBy'
        ]) && (refundAmountApproval() || allocationCancellation());
    }
    function payoutReviewer(a) {
      return manager() || (advanceOfficer() && ownAllocation(a));
    }
    function payoutParentChange(allocationId) {
      let a=resource.data;
      let b=request.resource.data;
      let pid=b.get('splitMutationId','');
      let after=getAfter(/databases/$(database)/documents/advancePayouts/$(pid)).data;
      let existed=exists(/databases/$(database)/documents/advancePayouts/$(pid));
      let before=existed ? get(/databases/$(database)/documents/advancePayouts/$(pid)).data : {};
      return enabledUser() && a.get('deleted',false)==false
        && b.get('payoutSplit',false)==true
        && a.get('allocationReceivedConfirmed',false)==false
        && a.get('refundReported',false)==false
        && b.diff(a).affectedKeys().hasOnly(['payoutSplit','splitAssigned','splitUnreceived','splitRefundTotal','splitMutationId','splitRecipients','updatedAt','updatedBy'])
        && after.allocationId==allocationId
        && b.splitAssigned>=0 && b.splitAssigned<=a.estimatedAmount
        && b.splitUnreceived>=0 && b.splitUnreceived<=b.splitAssigned
        && b.splitRefundTotal>=0 && b.splitRefundTotal<=b.splitAssigned
        && b.updatedBy==email()
        && (
          (!existed && payoutReviewer(a) && after.createdBy==email()
            && after.amount is int && after.amount>0
            && b.splitAssigned==a.get('splitAssigned',0)+after.amount
            && b.splitUnreceived==a.get('splitUnreceived',0)+after.amount
            && b.splitRefundTotal==a.get('splitRefundTotal',0)
            && b.splitRecipients.diff(a.get('splitRecipients',{})).affectedKeys().hasOnly([after.ownerEmail])
            && b.splitRecipients[after.ownerEmail]==true)
          || (existed && before.get('deleted',false)==false
            && b.splitRecipients==a.splitRecipients
            && (
              (before.ownerEmail==email() && before.receivedConfirmed==false && after.receivedConfirmed==true
                && after.get('deleted',false)==false
                && b.splitAssigned==a.splitAssigned && b.splitRefundTotal==a.splitRefundTotal
                && b.splitUnreceived==a.splitUnreceived-before.amount)
              || (payoutReviewer(a) && before.receivedConfirmed==false && after.deleted==true
                && b.splitAssigned==a.splitAssigned-before.amount
                && b.splitUnreceived==a.splitUnreceived-before.amount
                && b.splitRefundTotal==a.splitRefundTotal)
              || (payoutReviewer(a) && before.receivedConfirmed==true && before.refundPending>0
                && after.refundPending==0 && after.refundTotal==before.refundTotal+before.refundPending
                && b.splitAssigned==a.splitAssigned && b.splitUnreceived==a.splitUnreceived
                && b.splitRefundTotal==a.splitRefundTotal+before.refundPending
                && getAfter(/databases/$(database)/documents/expenseRecords/$(a.expenseRecordId)).data.amount==a.estimatedAmount-b.splitRefundTotal)
            ))
        );
    }
    function payoutExpenseRefund() {
      let a=get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      let b=getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      let p=get(/databases/$(database)/documents/advancePayouts/$(b.splitMutationId)).data;
      let q=getAfter(/databases/$(database)/documents/advancePayouts/$(b.splitMutationId)).data;
      return a.get('payoutSplit',false)==true && payoutReviewer(a)
        && resource.data.amount==a.estimatedAmount-a.splitRefundTotal
        && p.allocationId==resource.data.advanceAllocationId && p.refundPending>0
        && q.refundPending==0 && q.refundTotal==p.refundTotal+p.refundPending
        && b.splitRefundTotal==a.splitRefundTotal+p.refundPending
        && request.resource.data.amount==a.estimatedAmount-b.splitRefundTotal
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','updatedAt','updatedBy']);
    }
    match /advancePayouts/{payoutId} {
      allow read: if manager() || (enabledUser() && resource.data.ownerEmail==email())
        || (advanceOfficer() && resource.data.handlerEmail==email());
      allow create: if enabledUser()
        && request.resource.data.keys().hasOnly(['allocationId','expenseRecordId','batchId','planId','handlerEmail','ownerEmail','ownerName','purpose','categoryName','amount','receivedConfirmed','refundTotal','refundPending','deleted','createdBy','createdAt','updatedAt','updatedBy'])
        && request.resource.data.createdBy==email() && request.resource.data.createdAt==request.time
        && request.resource.data.amount is int && request.resource.data.amount>0
        && request.resource.data.receivedConfirmed==false && request.resource.data.refundTotal==0
        && request.resource.data.refundPending==0 && request.resource.data.deleted==false
        && get(/databases/$(database)/documents/users/$(request.resource.data.ownerEmail)).data.enabled==true
        && request.resource.data.planId==get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.planId
        && request.resource.data.batchId==get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.batchId
        && request.resource.data.expenseRecordId==get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.expenseRecordId
        && request.resource.data.handlerEmail==get(/databases/$(database)/documents/advanceBatches/$(request.resource.data.batchId)).data.handlerEmail
        && payoutReviewer(get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data)
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.splitMutationId==payoutId
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.splitAssigned==get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.get('splitAssigned',0)+request.resource.data.amount;
      allow update: if enabledUser() && resource.data.deleted==false
        && get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.get('deleted',false)==false
        && request.resource.data.updatedBy==email()
        && (
          (resource.data.ownerEmail==email() && resource.data.receivedConfirmed==false && request.resource.data.receivedConfirmed==true
            && request.resource.data.receivedBy==email() && request.resource.data.receivedAt==request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedConfirmed','receivedBy','receivedAt','updatedAt','updatedBy'])
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitMutationId==payoutId
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitUnreceived==get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitUnreceived-resource.data.amount)
          || (resource.data.ownerEmail==email() && resource.data.receivedConfirmed==true && resource.data.refundPending==0
            && request.resource.data.refundPending is int && request.resource.data.refundPending>0
            && request.resource.data.refundPending<=resource.data.amount-resource.data.refundTotal
            && request.resource.data.refundReportedBy==email() && request.resource.data.refundReportedAt==request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundPending','refundReportedBy','refundReportedAt','updatedAt','updatedBy']))
          || (payoutReviewer(get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data)
            && resource.data.receivedConfirmed==false && request.resource.data.deleted==true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','updatedAt','updatedBy'])
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitMutationId==payoutId
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitAssigned==get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitAssigned-resource.data.amount)
          || (payoutReviewer(get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data)
            && resource.data.receivedConfirmed==true && resource.data.refundPending>0
            && request.resource.data.refundPending==0 && request.resource.data.refundTotal==resource.data.refundTotal+resource.data.refundPending
            && request.resource.data.refundReceivedBy==email() && request.resource.data.refundReceivedAt==request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundTotal','refundPending','refundHistory','refundReceivedBy','refundReceivedAt','updatedAt','updatedBy'])
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitMutationId==payoutId
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitRefundTotal==get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitRefundTotal+resource.data.refundPending)
        );
      allow delete: if false;
    }

    function recordLocked() {
      return resource.data.get('reviewStatus', 'pending') == 'approved'
        || resource.data.get('reviewed', false) == true
        || resource.data.get('locked', false) == true;
    }

    function amountConfirmed(data) {
      return data.get('amountConfirmed', false) == true
        || data.get('amountManuallyConfirmed', false) == true
        || data.get('amountConfirmedByManagerWaiver', false) == true;
    }

    function hasVoucher(data) {
      return data.get('voucherUrl', '') != ''
        || data.get('folderUrl', '') != '';
    }

    function voucherWaived(data) {
      return data.get('voucherNotRequired', false) == true
        || data.get('voucherRequirementWaived', false) == true;
    }

    function voucherWaiverRequested(data) {
      return data.get('voucherNotRequiredRequested', false) == true;
    }

    function submissionComplete(data) {
      return data.get('estimated', false) == true
        || voucherWaiverRequested(data)
        || (
          amountConfirmed(data)
          && (
            (data.get('archived', false) == true && hasVoucher(data))
            || voucherWaived(data)
          )
        );
    }

    function linked(data) {
      return data.get('advanceAllocationId', '') != '';
    }
    function adjustmentApproval() {
      let before = resource.data.get('actualAdjustment', {});
      let after = request.resource.data.get('actualAdjustment', {});
      return manager()
        && before.get('status', '') == 'pending'
        && after.get('status', '') == 'approved'
        && after.get('amount', -1) == before.get('amount', -2)
        && after.get('requestedBy', '') == before.get('requestedBy', '')
        && after.get('reviewedBy', '') == email()
        && request.resource.data.amount == before.amount
        && request.resource.data.estimated == false
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.settlementAmount == before.amount;
    }
    function refundAmountApproval() {
      let a = get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      let after = getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      return refundReviewer(a) && resource.data.ownerEmail == a.ownerEmail && a.get('refundReported', false) == true
        && a.get('refundReceivedConfirmed', false) == false
        && after.get('refundReceivedConfirmed', false) == true
        && after.refundReceivedBy == email()
        && after.refundAmount == a.refundAmount
        && request.resource.data.amount == a.estimatedAmount - a.refundAmount;
    }
    function allocationCancellation() {
      return (manager() || (advanceOfficer() && resource.data.ownerEmail == email() && ownAllocation(get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data)))
        && request.resource.data.get('advanceAllocationId', '') == ''
        && request.resource.data.amount == resource.data.amount
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.get('deleted', false) == true;
    }
    function linkedRecordProtected() {
      return !linked(resource.data) || allocationCancellation() || (
        request.resource.data.get('advanceAllocationId', '') == resource.data.advanceAllocationId
        && request.resource.data.get('advanceBatchId', '') == resource.data.get('advanceBatchId', '')
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.categoryId == resource.data.categoryId
        && request.resource.data.semester == resource.data.semester
        && request.resource.data.get('originalEstimatedAmount', 0) == resource.data.get('originalEstimatedAmount', 0)
        && (request.resource.data.amount == resource.data.amount || adjustmentApproval() || refundAmountApproval() || payoutExpenseRefund())
        && (request.resource.data.get('estimated', false) == resource.data.get('estimated', false) || adjustmentApproval() || (request.resource.data.get('estimated', true) == false && amountConfirmed(request.resource.data) && hasVoucher(request.resource.data) && request.resource.data.get('archived', false) == true))
      );
    }
    function adjustmentProtected() {
      let before = resource.data.get('actualAdjustment', {});
      let after = request.resource.data.get('actualAdjustment', {});
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['actualAdjustment'])
        || (
          linked(resource.data)
          && before.get('status', '') in ['', 'rejected']
          && after.keys().hasOnly(['status','amount','reason','requestedBy','requestedAt'])
          && after.status == 'pending'
          && after.amount is number && after.amount >= 0
          && after.amount <= get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.estimatedAmount
          && after.reason is string && after.reason.size() > 0 && after.reason.size() <= 300
          && after.requestedBy == email() && after.requestedAt == request.time
          && request.resource.data.estimated == true
          && request.resource.data.amountConfirmed == true && hasVoucher(request.resource.data)
        )
        || ((manager() || (advanceOfficer() && resource.data.ownerEmail == email())) && before.get('status', '') == 'pending' && (
          adjustmentApproval()
          || (after.status == 'cancelled' && refundAmountApproval())
          || (after.status == 'rejected' && after.amount == before.amount
            && after.requestedBy == before.requestedBy && after.reviewedBy == email()
            && request.resource.data.amount == resource.data.amount)
        ));
    }
    function allocationFixed() {
      return request.resource.data.estimatedAmount == resource.data.estimatedAmount
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.expenseRecordId == resource.data.expenseRecordId
        && request.resource.data.batchId == resource.data.batchId;
    }
    function refundOwed() {
      return resource.data.get('allocationReceivedConfirmed', false) == true
        && request.resource.data.get('refundAmount', 0) is int
        && request.resource.data.refundAmount > 0
        && request.resource.data.refundAmount <= resource.data.estimatedAmount;
    }
    function teacherRefundReport() {
      return enabledUser() && resource.data.ownerEmail == email()
        && (resource.data.get('refundReported', false) == false || resource.data.get('refundReceivedConfirmed', false) == true)
        && request.resource.data.get('refundReceivedConfirmed', true) == false
        && request.resource.data.get('refundConfirmedTotal', -1) == resource.data.get('refundConfirmedTotal', resource.data.get('refundReceivedConfirmed', false) == true ? resource.data.get('refundAmount', 0) : 0)
        && request.resource.data.refundAmount > request.resource.data.refundConfirmedTotal
        && request.resource.data.refundReported == true
        && request.resource.data.refundReportedBy == email()
        && request.resource.data.refundReportedAt == request.time
        && refundOwed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'refundReported','refundAmount','refundReportedBy','refundReportedAt','refundReceivedConfirmed','refundConfirmedTotal','updatedAt','updatedBy'
        ]);
    }
    function refundReceiptProtected() {
      return teacherRefundReport()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['refundReceivedConfirmed','refundReceivedBy','refundReceivedAt','refundConfirmedTotal','refundHistory'])
        || (refundReviewer(resource.data) && resource.data.get('refundReported', false) == true
          && resource.data.get('refundReceivedConfirmed', false) == false
          && request.resource.data.refundReceivedConfirmed == true
          && request.resource.data.refundReceivedBy == email()
          && request.resource.data.refundReceivedAt == request.time
          && request.resource.data.refundAmount == resource.data.refundAmount
          && request.resource.data.get('refundConfirmedTotal', -1) == resource.data.refundAmount && refundOwed()
          && getAfter(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data.amount == resource.data.estimatedAmount - resource.data.refundAmount);
    }

    match /users/{userEmail} {
      allow read: if manager() || advanceOfficer()
        || (enabledUser() && userEmail == email());
      allow create, update, delete: if manager();
    }

    match /budgetPlans/{planId} {
      allow read: if enabledUser();
      allow create, update, delete: if manager();
    }

    match /budgetCategories/{categoryId} {
      allow read: if enabledUser();
      allow create, update, delete: if manager();
    }

    // Advance/disbursement batches remain manager-managed, but enabled users may read
    // the batch metadata needed to understand their own allocations.
    match /advanceBatches/{batchId} {
      allow read: if enabledUser();
      allow create: if manager() || (ownBatch(request.resource.data)
        && request.resource.data.createdBy == email()
        && request.resource.data.get('deleted', false) == false);
      allow update: if manager() || (ownBatch(resource.data) && ownBatch(request.resource.data)
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == email());
      allow delete: if manager();
    }

    // Managers manage all allocations. Regular users may read only their own allocation
    // and may only confirm that the allocated amount was received.
    match /advanceAllocations/{allocationId} {
      allow read: if manager()
        || (enabledUser() && resource.data.ownerEmail == email())
        || (advanceOfficer() && ownBatch(get(/databases/$(database)/documents/advanceBatches/$(resource.data.batchId)).data))
        || (enabledUser() && resource.data.get('splitRecipients',{}).get(email(),false)==true);

      allow create: if manager() || (ownAllocation(request.resource.data)
        && request.resource.data.keys().hasOnly(['planId','batchId','expenseRecordId','categoryId','categoryName','ownerEmail','ownerName','purpose','estimatedAmount','note','recordOrigin','deleted','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.createdBy == email()
        && request.resource.data.get('deleted', false) == false
        && request.resource.data.get('allocationReceivedConfirmed', false) == false
        && request.resource.data.get('refundReported', false) == false
        && request.resource.data.get('refundReceivedConfirmed', false) == false
        && request.resource.data.get('refundConfirmedTotal', 0) == 0
        && request.resource.data.get('refundAmount', 0) == 0
        && request.resource.data.get('refundHistory', {}) == {}
        && request.resource.data.estimatedAmount > 0
        && get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.ownerEmail == email()
        && get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.get('advanceAllocationId', '') == ''
        && get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.estimated == true
        && get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.get('deleted', false) == false
        && request.resource.data.planId == get(/databases/$(database)/documents/advanceBatches/$(request.resource.data.batchId)).data.planId
        && request.resource.data.planId == get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.planId
        && request.resource.data.categoryId == get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.categoryId
        && request.resource.data.estimatedAmount == get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.amount
        && getAfter(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.advanceAllocationId == allocationId);
      allow delete: if manager();

      allow update: if allocationFixed() && refundReceiptProtected()
        && (request.resource.data.get('deleted',false)!=true || resource.data.get('splitAssigned',0)==0) && (
        (request.resource.data.get('payoutSplit',false)==true && payoutParentChange(allocationId)) ||
        manager()
        || teacherRefundReport()
        || (ownAllocation(resource.data)
          && request.resource.data.get('deleted', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','deletedAt','deletedBy','updatedAt','updatedBy','orphanSourceRemoved'])
          && request.resource.data.deletedBy == email()
          && (!exists(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId))
            || get(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data.get('deleted', false) == true
            || getAfter(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data.get('advanceAllocationId', '') == ''))
        || (advanceOfficer() && resource.data.ownerEmail == email()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundConfirmedTotal','refundHistory','refundReceivedConfirmed','refundReceivedBy','refundReceivedAt','settlementAmount','updatedAt','updatedBy'])
          && resource.data.get('refundReceivedConfirmed', false) == false
          && request.resource.data.refundReceivedConfirmed == true)
        || (
          enabledUser()
          && resource.data.ownerEmail == email()
          && resource.data.get('allocationReceivedConfirmed', false) == false
          && resource.data.get('payoutSplit',false)==false
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.get('allocationReceivedConfirmed', false) == true
          && request.resource.data.get('allocationReceivedBy', '') == email()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'allocationReceivedConfirmed',
            'allocationReceivedAt',
            'allocationReceivedBy',
            'updatedAt',
            'updatedBy'
          ])
        ));
    }

    // Reminder configuration and reminder history are manager-only.
    match /reminderSettings/{planId} {
      allow read, create, update, delete: if manager();
    }

    match /reminderLogs/{logId} {
      allow read, create: if manager();
      allow update, delete: if false;
    }

    match /expenseRecords/{recordId} {
      allow read: if enabledUser();

      allow create: if enabledUser()
        && request.resource.data.get('reviewStatus', 'pending') != 'approved'
        && request.resource.data.get('reviewed', false) == false
        && request.resource.data.get('locked', false) == false
        && (
          (
            manager()
            && request.resource.data.createdBy == email()
            && submissionComplete(request.resource.data)
          )
          || (
            !manager()
            && request.resource.data.ownerEmail == email()
            && request.resource.data.createdBy == email()
            && !voucherWaived(request.resource.data)
            && submissionComplete(request.resource.data)
          )
        );

      allow update: if enabledUser() && linkedRecordProtected() && adjustmentProtected()
        && (manager() || ownRecordServiceUpdate() || payoutExpenseRefund() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['actualAdjustmentHistory', 'refundAdjustment'])) && (
        ownRecordServiceUpdate() || payoutExpenseRefund() ||
        manager()
        || (
          resource.data.ownerEmail == email()
          && !recordLocked()
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.get('reviewStatus', 'pending') != 'approved'
          && request.resource.data.get('reviewed', false) == false
          && request.resource.data.get('locked', false) == false
          && request.resource.data.get('voucherNotRequired', false) == resource.data.get('voucherNotRequired', false)
          && request.resource.data.get('voucherRequirementWaived', false) == resource.data.get('voucherRequirementWaived', false)
          && request.resource.data.get('amountConfirmedByManagerWaiver', false) == resource.data.get('amountConfirmedByManagerWaiver', false)
          && submissionComplete(request.resource.data)
        )
      );

      allow delete: if enabledUser() && !linked(resource.data) && (
        manager()
        || (
          resource.data.ownerEmail == email()
          && !recordLocked()
        )
      );
    }

    match /auditLogs/{logId} {
      allow read: if manager();
      allow create: if manager() || (advanceOfficer()
        && request.resource.data.actorEmail == email()
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.type in ['advance-batch','advance-receipt']
            && ownBatch(getAfter(/databases/$(database)/documents/advanceBatches/$(request.resource.data.targetId)).data))
          || (request.resource.data.type == 'advance-allocation'
            && ownAllocation(getAfter(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.targetId)).data))));
      allow update, delete: if false;
    }
  }
}


