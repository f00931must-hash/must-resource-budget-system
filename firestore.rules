rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Permanent bootstrap account for budget permission synchronization.
    // This prevents the users collection from locking out the primary manager
    // if their own users document is temporarily missing or changed during testing.
    function primaryManager() {
      return signedIn() && email() == 'master004400@gmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(email()));
    }

    function enabledUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(email()))
        && userDoc().data.enabled == true;
    }

    function manager() {
      return enabledUser() && (primaryManager() || userDoc().data.role == 'manager');
    }

    // 預支承辦人僅可操作本人批次與本人分配，並保留一般使用者權限。
    function advanceOfficer() {
      return enabledUser() && userDoc().data.role == 'advance';
    }
    function ownBatch(data) {
      return advanceOfficer() && data.handlerEmail == email();
    }
    function ownAllocation(data) {
      return advanceOfficer() && data.ownerEmail == email()
        && get(/databases/$(database)/documents/advanceBatches/$(data.batchId)).data.handlerEmail == email();
    }
    function refundReviewer(data) {
      return manager() || (advanceOfficer() && data.ownerEmail == email());
    }

    function payoutReviewer(a) {
      return manager() || ownAllocation(a);
    }
    function payoutParentChange(allocationId) {
      let a=resource.data;
      let b=request.resource.data;
      let pid=b.get('splitMutationId','');
      let after=getAfter(/databases/$(database)/documents/advancePayouts/$(pid)).data;
      let existed=exists(/databases/$(database)/documents/advancePayouts/$(pid));
      let before=existed ? get(/databases/$(database)/documents/advancePayouts/$(pid)).data : {};
      return a.get('deleted',false) != true && b.get('payoutSplit',false)==true
        && a.get('allocationReceivedConfirmed',false) != true && a.get('refundReported',false) != true
        && b.diff(a).affectedKeys().hasOnly(['payoutSplit','splitAssigned','splitUnreceived','splitRefundTotal','splitMutationId','splitRecipients','updatedAt','updatedBy'])
        && after.allocationId==allocationId
        && b.splitAssigned>=0 && b.splitAssigned<=a.estimatedAmount
        && b.splitUnreceived>=0 && b.splitUnreceived<=b.splitAssigned
        && b.splitRefundTotal>=0 && b.splitRefundTotal<=b.splitAssigned
        && (existed ? (
          before.get('deleted',false) != true && b.splitRecipients==a.splitRecipients
          && (before.receivedConfirmed==false ? (
            after.get('deleted',false)==true ?
              (payoutReviewer(a) && b.splitAssigned==a.splitAssigned-before.amount
                && b.splitUnreceived==a.splitUnreceived-before.amount && b.splitRefundTotal==a.splitRefundTotal)
            : ((before.ownerEmail==email() || payoutReviewer(a)) && after.receivedConfirmed==true
                && b.splitAssigned==a.splitAssigned && b.splitRefundTotal==a.splitRefundTotal
                && b.splitUnreceived==a.splitUnreceived-before.amount)
          ) : (
            payoutReviewer(a) && before.refundPending>0 && after.refundPending==0
            && after.refundTotal==before.refundTotal+before.refundPending
            && b.splitAssigned==a.splitAssigned && b.splitUnreceived==a.splitUnreceived
            && b.splitRefundTotal==a.splitRefundTotal+before.refundPending
            && getAfter(/databases/$(database)/documents/expenseRecords/$(a.expenseRecordId)).data.amount==a.estimatedAmount-b.splitRefundTotal
          ))
        ) : (
          payoutReviewer(a) && after.createdBy==email() && after.amount is int && after.amount>0
          && b.splitAssigned==a.get('splitAssigned',0)+after.amount
          && b.splitUnreceived==a.get('splitUnreceived',0)+after.amount
          && b.splitRefundTotal==a.get('splitRefundTotal',0)
          && b.splitRecipients.diff(a.get('splitRecipients',{})).affectedKeys().hasOnly([after.ownerEmail])
          && b.splitRecipients[after.ownerEmail]==true
        ));
    }
    function payoutExpenseRefund() {
      let a=get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      let b=getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      let p=get(/databases/$(database)/documents/advancePayouts/$(b.splitMutationId)).data;
      let q=getAfter(/databases/$(database)/documents/advancePayouts/$(b.splitMutationId)).data;
      return a.get('payoutSplit',false)==true && payoutReviewer(a)
        && resource.data.amount==a.estimatedAmount-a.splitRefundTotal
        && p.allocationId==resource.data.advanceAllocationId && p.refundPending>0
        && q.refundPending==0 && q.refundTotal==p.refundTotal+p.refundPending
        && b.splitRefundTotal==a.splitRefundTotal+p.refundPending
        && request.resource.data.amount==a.estimatedAmount-b.splitRefundTotal
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','updatedAt','updatedBy']);
    }
    function splitBatchHandler(payout) {
      let batch = get(/databases/$(database)/documents/advanceBatches/$(payout.batchId)).data;
      let handler = batch.get('handlerEmail', '');
      return handler != '' && handler != null ? handler
        : get(/databases/$(database)/documents/advanceAllocations/$(payout.allocationId)).data.ownerEmail;
    }

    function payoutReceive(payoutId) {
      return (resource.data.ownerEmail==email() || manager()) && resource.data.receivedConfirmed==false && request.resource.data.receivedConfirmed==true
            && request.resource.data.receivedBy==email() && request.resource.data.receivedAt==request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedConfirmed','receivedBy','receivedAt','updatedAt','updatedBy'])
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitMutationId==payoutId
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitUnreceived==get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitUnreceived-resource.data.amount;
    }

    function payoutReport(payoutId) {
      return (resource.data.ownerEmail==email() || manager()) && resource.data.receivedConfirmed==true && resource.data.refundPending==0
            && request.resource.data.refundPending is int && request.resource.data.refundPending>0
            && request.resource.data.refundPending<=resource.data.amount-resource.data.refundTotal
            && request.resource.data.refundReportedBy==email() && request.resource.data.refundReportedAt==request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundPending','refundReportedBy','refundReportedAt','updatedAt','updatedBy']);
    }

    function payoutRemove(payoutId) {
      return payoutReviewer(get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data)
            && resource.data.receivedConfirmed==false && request.resource.data.deleted==true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','updatedAt','updatedBy'])
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitMutationId==payoutId
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitAssigned==get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitAssigned-resource.data.amount;
    }

    function payoutRefundReceipt(payoutId) {
      return payoutReviewer(get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data)
            && resource.data.receivedConfirmed==true && resource.data.refundPending>0
            && request.resource.data.refundPending==0 && request.resource.data.refundTotal==resource.data.refundTotal+resource.data.refundPending
            && request.resource.data.refundReceivedBy==email() && request.resource.data.refundReceivedAt==request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundTotal','refundPending','refundHistory','refundReceivedBy','refundReceivedAt','updatedAt','updatedBy'])
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitMutationId==payoutId
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitRefundTotal==get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.splitRefundTotal+resource.data.refundPending;
    }

    function payoutUpdate(payoutId) {
      let k=changed();
      return resource.data.get('deleted', false) != true
        && get(/databases/$(database)/documents/advanceAllocations/$(resource.data.allocationId)).data.get('deleted', false) != true
        && (k.hasAny(['deleted']) ? payoutRemove(payoutId)
          : k.hasAny(['receivedConfirmed','receivedBy','receivedAt']) ? payoutReceive(payoutId)
          : k.hasAny(['refundTotal','refundReceivedBy','refundReceivedAt','refundHistory']) ? payoutRefundReceipt(payoutId)
          : k.hasAny(['refundPending','refundReportedBy','refundReportedAt']) ? payoutReport(payoutId)
          : false);
    }

    match /advancePayouts/{payoutId} {
      allow read: if manager() || (enabledUser() && resource.data.ownerEmail==email())
        || (advanceOfficer() && resource.data.handlerEmail==email());
      allow create: if enabledUser()
        && request.resource.data.keys().hasOnly(['allocationId','expenseRecordId','batchId','planId','handlerEmail','ownerEmail','ownerName','purpose','categoryName','amount','receivedConfirmed','refundTotal','refundPending','deleted','createdBy','createdAt','updatedAt','updatedBy'])
        && request.resource.data.createdBy==email() && request.resource.data.createdAt==request.time
        && request.resource.data.amount is int && request.resource.data.amount>0
        && request.resource.data.receivedConfirmed==false && request.resource.data.refundTotal==0
        && request.resource.data.refundPending==0 && request.resource.data.deleted==false
        && get(/databases/$(database)/documents/users/$(request.resource.data.ownerEmail)).data.enabled==true
        && request.resource.data.planId==get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.planId
        && request.resource.data.batchId==get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.batchId
        && request.resource.data.expenseRecordId==get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.expenseRecordId
        && request.resource.data.handlerEmail==splitBatchHandler(request.resource.data)
        && payoutReviewer(get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data)
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.splitMutationId==payoutId
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.splitAssigned==get(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.allocationId)).data.get('splitAssigned',0)+request.resource.data.amount;
      allow update: if enabledUser() && stamped() && payoutUpdate(payoutId);
      allow delete: if false;
    }

    function recordLocked() {
      return resource.data.get('reviewStatus', 'pending') == 'approved'
        || resource.data.get('reviewed', false) == true
        || resource.data.get('locked', false) == true;
    }

    function amountConfirmed(data) {
      return data.get('amountConfirmed', false) == true
        || data.get('amountManuallyConfirmed', false) == true
        || data.get('amountConfirmedByManagerWaiver', false) == true;
    }

    function hasVoucher(data) {
      return data.get('voucherUrl', '') != ''
        || data.get('folderUrl', '') != '';
    }

    function voucherWaived(data) {
      return data.get('voucherNotRequired', false) == true
        || data.get('voucherRequirementWaived', false) == true;
    }

    function voucherWaiverRequested(data) {
      return data.get('voucherNotRequiredRequested', false) == true;
    }

    function submissionComplete(data) {
      return data.get('estimated', false) == true
        || voucherWaiverRequested(data)
        || (
          amountConfirmed(data)
          && (
            (data.get('archived', false) == true && hasVoucher(data))
            || voucherWaived(data)
          )
        );
    }

    function linked(data) {
      let allocationId = data.get('advanceAllocationId', '');
      return allocationId != null && allocationId != '';
    }

    function refundAmountApproval() {
      let a = get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      let after = getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data;
      return refundReviewer(a) && resource.data.ownerEmail == a.ownerEmail && a.get('refundReported', false) == true
        && a.get('refundReceivedConfirmed', false) != true
        && after.get('refundReceivedConfirmed', false) == true
        && after.refundReceivedBy == email()
        && after.refundAmount == a.refundAmount
        && request.resource.data.amount == a.estimatedAmount - a.refundAmount;
    }
    function allocationCancellation() {
      return (manager() || (advanceOfficer() && resource.data.ownerEmail == email() && ownAllocation(get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data)))
        && request.resource.data.get('advanceAllocationId', '') == ''
        && request.resource.data.amount == resource.data.amount
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.get('deleted', false) == true;
    }


    function allocationFixed() {
      return request.resource.data.estimatedAmount == resource.data.estimatedAmount
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.expenseRecordId == resource.data.expenseRecordId
        && request.resource.data.batchId == resource.data.batchId;
    }
    function refundOwed() {
      return resource.data.get('allocationReceivedConfirmed', false) == true
        && request.resource.data.get('refundAmount', 0) is int
        && request.resource.data.refundAmount > 0
        && request.resource.data.refundAmount <= resource.data.estimatedAmount;
    }
    function confirmedRefundTotal(data) {
      let total=data.get('refundConfirmedTotal',null);
      return total is number ? total : (data.get('refundReceivedConfirmed',false)==true ? data.get('refundAmount',0) : 0);
    }
    function teacherRefundReport() {
      return enabledUser() && (resource.data.ownerEmail == email() || manager())
        && (resource.data.get('refundReported', false) != true || resource.data.get('refundReceivedConfirmed', false) == true)
        && request.resource.data.get('refundReceivedConfirmed', true) == false
        && request.resource.data.get('refundConfirmedTotal', -1) == confirmedRefundTotal(resource.data)
        && request.resource.data.refundAmount > request.resource.data.refundConfirmedTotal
        && request.resource.data.refundReported == true
        && request.resource.data.refundReportedBy == email()
        && request.resource.data.refundReportedAt == request.time
        && resource.data.get('allocationReceivedConfirmed', false) == true
        && resource.data.get('deleted', false) != true
        && resource.data.get('payoutSplit', false) != true
        && request.resource.data.refundAmount is int
        && request.resource.data.refundAmount <= resource.data.estimatedAmount
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'refundReported','refundAmount','refundReportedBy','refundReportedAt','refundReceivedConfirmed','refundConfirmedTotal','updatedAt','updatedBy'
        ]);
    }
    function refundReceiptProtected() {
      return teacherRefundReport()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['refundReceivedConfirmed','refundReceivedBy','refundReceivedAt','refundConfirmedTotal','refundHistory'])
        || (refundReviewer(resource.data) && resource.data.get('refundReported', false) == true
          && resource.data.get('refundReceivedConfirmed', false) != true
          && request.resource.data.refundReceivedConfirmed == true
          && request.resource.data.refundReceivedBy == email()
          && request.resource.data.refundReceivedAt == request.time
          && request.resource.data.refundAmount == resource.data.refundAmount
          && request.resource.data.get('refundConfirmedTotal', -1) == resource.data.refundAmount && refundOwed()
          && getAfter(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data.amount == resource.data.estimatedAmount - resource.data.refundAmount);
    }

    match /users/{userEmail} {
      allow read: if manager() || advanceOfficer()
        || (signedIn() && userEmail == email());
      // The designated bootstrap account may repair only its own manager profile.
      allow create, update: if manager() || (primaryManager() && userEmail == email()
        && request.resource.data.enabled == true && request.resource.data.role == 'manager');
      allow delete: if manager();
    }

    match /budgetPlans/{planId} {
      allow read: if enabledUser();
      allow create, update, delete: if manager();
    }

    match /budgetCategories/{categoryId} {
      allow read: if enabledUser();
      allow create, update, delete: if manager();
    }

    // Advance/disbursement batches remain manager-managed, but enabled users may read
    // the batch metadata needed to understand their own allocations.
    match /advanceBatches/{batchId} {
      allow read: if enabledUser();
      allow create: if manager() || (ownBatch(request.resource.data)
        && request.resource.data.createdBy == email()
        && request.resource.data.get('deleted', false) != true);
      allow update: if manager() || (ownBatch(resource.data) && ownBatch(request.resource.data)
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == email());
      allow delete: if manager();
    }

    // Managers manage all allocations. Regular users may read only their own allocation
    // and may only confirm that the allocated amount was received.

    function allocationTopUp(allocationId) {
      return managerAdvanceTopUp()
        && getAfter(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data.advanceAllocationId == allocationId
        && getAfter(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data.advanceTopUpTotal == request.resource.data.advanceTopUpTotal;
    }
    function allocationReceive() {
      return (resource.data.ownerEmail == email() || manager())
        && resource.data.get('allocationReceivedConfirmed', false) != true
        && resource.data.get('payoutSplit', false) != true
        && request.resource.data.allocationReceivedConfirmed == true
        && request.resource.data.allocationReceivedBy == email() && request.resource.data.allocationReceivedAt == request.time
        && changed().hasOnly(['allocationReceivedConfirmed','allocationReceivedAt','allocationReceivedBy','updatedAt','updatedBy']);
    }
    function allocationRefundReceipt() {
      return refundReviewer(resource.data) && allocationFixed() && refundReceiptProtected()
        && changed().hasOnly(['refundConfirmedTotal','refundHistory','refundReceivedConfirmed','refundReceivedBy',
          'refundReceivedAt','settlementAmount','updatedAt','updatedBy']);
    }
    function allocationRemove() {
      let rid = resource.data.expenseRecordId;
      return (manager() || ownAllocation(resource.data))
        && resource.data.get('splitAssigned', 0) == 0 && request.resource.data.deleted == true
        && request.resource.data.deletedBy == email() && request.resource.data.deletedAt == request.time
        && changed().hasOnly(['deleted','deletedAt','deletedBy','updatedAt','updatedBy','orphanSourceRemoved'])
        && (!exists(/databases/$(database)/documents/expenseRecords/$(rid))
          || get(/databases/$(database)/documents/expenseRecords/$(rid)).data.get('deleted', false)
          || getAfter(/databases/$(database)/documents/expenseRecords/$(rid)).data.get('advanceAllocationId', '') == '');
    }
    function allocationAdjustmentSettlement() {
      let before=get(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data;
      let after=getAfter(/databases/$(database)/documents/expenseRecords/$(resource.data.expenseRecordId)).data;
      return manager() && changed().hasOnly(['settlementAmount','updatedAt','updatedBy'])
        && before.get('actualAdjustment',{}).get('status','') == 'pending'
        && after.actualAdjustment.status == 'approved'
        && after.actualAdjustment.reviewedBy == email()
        && after.amount == before.actualAdjustment.amount
        && request.resource.data.settlementAmount == after.amount;
    }
    function allocationUpdate(allocationId) {
      let k = changed();
      return resource.data.get('deleted', false) != true && (
        k.hasAny(['payoutSplit','splitAssigned','splitUnreceived','splitRefundTotal','splitMutationId','splitRecipients']) ? payoutParentChange(allocationId)
        : k.hasAny(['advanceTopUpTotal']) ? allocationTopUp(allocationId)
        : k.hasAny(['refundReported','refundAmount','refundReportedAt','refundReportedBy']) ? teacherRefundReport()
        : k.hasAny(['refundReceivedConfirmed','refundConfirmedTotal','refundHistory']) ? allocationRefundReceipt()
        : k.hasAny(['allocationReceivedConfirmed','allocationReceivedBy','allocationReceivedAt']) ? allocationReceive()
        : k.hasAny(['deleted']) ? allocationRemove()
        : k.hasAny(['settlementAmount']) ? allocationAdjustmentSettlement()
        : manager() && k.hasOnly(['note','updatedAt','updatedBy'])
      );
    }

    match /advanceAllocations/{allocationId} {
      allow read: if manager()
        || (enabledUser() && resource.data.ownerEmail == email())
        || (advanceOfficer() && ownBatch(get(/databases/$(database)/documents/advanceBatches/$(resource.data.batchId)).data))
        || (enabledUser() && resource.data.get('splitRecipients',{}).get(email(),false)==true);
      allow create: if manager() || (ownAllocation(request.resource.data)
        && request.resource.data.keys().hasOnly(['planId','batchId','expenseRecordId','categoryId','categoryName','ownerEmail','ownerName','purpose','estimatedAmount','note','recordOrigin','deleted','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.createdBy == email()
        && request.resource.data.get('deleted', false) != true
        && request.resource.data.get('allocationReceivedConfirmed', false) != true
        && request.resource.data.get('refundReported', false) != true
        && request.resource.data.get('refundReceivedConfirmed', false) != true
        && request.resource.data.get('refundConfirmedTotal', 0) == 0
        && request.resource.data.get('refundAmount', 0) == 0
        && request.resource.data.get('refundHistory', {}) == {}
        && request.resource.data.estimatedAmount > 0
        && get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.ownerEmail == email()
        && !linked(get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data)
        && get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.estimated == true
        && get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.get('deleted', false) != true
        && request.resource.data.planId == get(/databases/$(database)/documents/advanceBatches/$(request.resource.data.batchId)).data.planId
        && request.resource.data.planId == get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.planId
        && request.resource.data.categoryId == get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.categoryId
        && request.resource.data.estimatedAmount == get(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.amount
        && getAfter(/databases/$(database)/documents/expenseRecords/$(request.resource.data.expenseRecordId)).data.advanceAllocationId == allocationId);
      allow update: if enabledUser() && stamped() && allocationUpdate(allocationId);
      allow delete: if manager();
    }

    // Reminder configuration and reminder history are manager-only.
    match /reminderSettings/{planId} {
      allow read, create, update, delete: if manager();
    }

    match /reminderLogs/{logId} {
      allow read, create: if manager();
      allow update, delete: if false;
    }



    function managerAdvanceTopUp() {
      return enabledUser() && manager()
        && resource.data.get('deleted', false) != true
        && request.resource.data.advanceTopUpTotal is int
        && request.resource.data.advanceTopUpTotal > resource.data.get('advanceTopUpTotal', 0)
        && request.resource.data.advanceTopUpTotal <= 9007199254740991
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['advanceTopUpTotal','updatedBy','updatedAt']);
    }

    function linkExistingEstimate(recordId) {
      let next = request.resource.data;
      let allocationId = next.get('advanceAllocationId', '');
      let allocationPath = /databases/$(database)/documents/advanceAllocations/$(allocationId);
      let allocation = getAfter(allocationPath).data;
      let batch = get(/databases/$(database)/documents/advanceBatches/$(next.advanceBatchId)).data;
      let categoryIds = batch.get('categoryIds', []) is list ? batch.get('categoryIds', []) : [];
      return allocationId != ''
        && !exists(allocationPath)
        && !linked(resource.data)
        && !recordLocked()
        && resource.data.get('deleted', false) != true
        && resource.data.get('estimated', false) == true
        && (manager() || (ownBatch(batch) && resource.data.ownerEmail == email()))
        && batch.get('deleted', false) == false
        && batch.planId == resource.data.planId
        && batch.semester == resource.data.semester
        && (resource.data.categoryId in categoryIds
          || (categoryIds.size() == 0 && batch.get('categoryId', '') == resource.data.categoryId))
        && allocation.expenseRecordId == recordId
        && allocation.batchId == next.advanceBatchId
        && allocation.planId == resource.data.planId
        && allocation.categoryId == resource.data.categoryId
        && allocation.ownerEmail == resource.data.ownerEmail
        && allocation.estimatedAmount == resource.data.amount
        && allocation.createdBy == email()
        && allocation.recordOrigin == 'existing-estimate'
        && allocation.get('deleted', false) == false
        && next.advanceLinked == true
        && next.originalEstimatedAmount == (resource.data.get('originalEstimatedAmount', null) == null ? resource.data.amount : resource.data.originalEstimatedAmount)
        && next.updatedAt == request.time
        && next.updatedBy == email()
        && next.diff(resource.data).affectedKeys().hasOnly([
          'advanceAllocationId','advanceBatchId','advanceLinked','originalEstimatedAmount','updatedAt','updatedBy'
        ]);
    }

    function eligibleExpenseOwner(target) {
      let user = get(/databases/$(database)/documents/users/$(target)).data;
      return user.enabled == true && user.get('role', '') != 'assistant';
    }

    function validExpenseNumbers(data) {
      return data.get('purchaseOrderNo', '') is string
        && data.get('purchaseOrderNo', '').size() <= 80
        && data.get('reimbursementNo', '') is string
        && data.get('reimbursementNo', '').size() <= 80;
    }

    function expenseRefund() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','refundAdjustment','actualAdjustment','updatedAt','updatedBy'])
        && enabledUser()
        && linked(resource.data)
        && resource.data.get('deleted', false) != true
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == email()
        && request.resource.data.amount >= 0
        && request.resource.data.amount < resource.data.amount
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','updatedAt','updatedBy'])
            && payoutExpenseRefund())
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'amount','refundAdjustment','actualAdjustment','updatedAt','updatedBy'
              ])
            && refundAmountApproval()
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['actualAdjustment'])
              || (resource.data.get('actualAdjustment', {}).get('status', '') == 'pending'
                && request.resource.data.actualAdjustment.diff(resource.data.actualAdjustment).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
                && request.resource.data.actualAdjustment.status == 'cancelled'
                && request.resource.data.actualAdjustment.reviewedBy == email()
                && request.resource.data.actualAdjustment.reviewedAt == request.time))
            && request.resource.data.refundAdjustment.allocationId == resource.data.advanceAllocationId
            && request.resource.data.refundAdjustment.remainingAmount == request.resource.data.amount
            && request.resource.data.refundAdjustment.confirmedBy == email()
            && request.resource.data.refundAdjustment.confirmedAt == request.time)
        );
    }

    function expenseForm() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'categoryId','purpose','amount','semester','estimated','estimateStage','hanlongAdvance',
          'archived','amountConfirmed','reviewStatus','reviewed','locked','note','ownerName',
          'voucherFileName','voucherPath','voucherStoragePath','voucherUrl','voucherFileSize',
          'voucherFileType','purchaseOrderNo','reimbursementNo','updatedAt','updatedBy'
        ])
        && enabledUser() && (resource.data.ownerEmail == email() || manager())
        && resource.data.get('deleted', false) != true && !recordLocked()
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && validExpenseNumbers(request.resource.data)
        && request.resource.data.get('reviewed', false) != true
        && request.resource.data.get('locked', false) != true
        && (
          (request.resource.data.estimated == true
            && request.resource.data.reviewStatus == 'estimated'
            && request.resource.data.get('estimateStage', 'estimated') in ['estimated','purchasing','reimbursing'])
          || (request.resource.data.estimated == false
            && request.resource.data.reviewStatus == 'pending'
            && request.resource.data.get('estimateStage', '') == ''
            && submissionComplete(request.resource.data))
        )
        && (!linked(resource.data) || (
          request.resource.data.amount == resource.data.amount
          && request.resource.data.categoryId == resource.data.categoryId
          && request.resource.data.semester == resource.data.semester
          && (resource.data.get('estimated', false) == true || request.resource.data.estimated == false)
        ));
    }

    function expenseCorrection() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'purpose','note','purchaseOrderNo','reimbursementNo','amount','updatedAt','updatedBy'
        ]) && (manager() || (enabledUser() && resource.data.ownerEmail == email()))
        && resource.data.get('deleted', false) != true && !recordLocked()
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time
        && validExpenseNumbers(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'purpose','note','purchaseOrderNo','reimbursementNo','amount','updatedAt','updatedBy'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount'])
          || (!linked(resource.data) && request.resource.data.amount is number && request.resource.data.amount >= 0));
    }

    function expenseReview() {
      return manager()
        && resource.data.get('deleted', false) != true
        && resource.data.get('estimated', false) != true
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && (
          (
            !recordLocked()
            && ((hasVoucher(resource.data) && amountConfirmed(resource.data))
              || resource.data.get('amountConfirmedByManagerWaiver', false) == true)
            && request.resource.data.reviewStatus == 'approved'
            && request.resource.data.reviewed == true
            && request.resource.data.locked == true
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewedBy == email()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reviewStatus','reviewed','locked','reviewedAt','reviewedBy','updatedAt','updatedBy'
            ])
          ) || (
            recordLocked()
            && request.resource.data.reviewStatus == 'pending'
            && request.resource.data.reviewed == false
            && request.resource.data.locked == false
            && request.resource.data.unlockedAt == request.time
            && request.resource.data.unlockedBy == email()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reviewStatus','reviewed','locked','unlockedAt','unlockedBy','updatedAt','updatedBy'
            ])
          )
        );
    }

    function expenseWaiverRequest() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['voucherNotRequiredRequestedAt','voucherNotRequiredRequestedBy'])
        && request.resource.data.get('voucherNotRequiredRequested', false) == true
        && enabledUser() && (resource.data.ownerEmail == email() || manager())
        && !recordLocked() && resource.data.get('deleted', false) != true
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time
        && request.resource.data.voucherNotRequiredRequestedBy == email()
        && request.resource.data.voucherNotRequiredRequestedAt == request.time
        && request.resource.data.estimated == false
        && request.resource.data.reviewStatus == 'pending'
        && request.resource.data.reviewed == false && request.resource.data.locked == false
        && !hasVoucher(request.resource.data)
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && validExpenseNumbers(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'categoryId','purpose','amount','semester','estimated','estimateStage','hanlongAdvance',
          'archived','amountConfirmed','reviewStatus','reviewed','locked','note','ownerName',
          'voucherNotRequiredRequested','voucherNotRequiredRequestedAt','voucherNotRequiredRequestedBy',
          'purchaseOrderNo','reimbursementNo','updatedAt','updatedBy'
        ])
        && (!linked(resource.data) || (
          request.resource.data.amount == resource.data.amount
          && request.resource.data.categoryId == resource.data.categoryId
          && request.resource.data.semester == resource.data.semester
        ));
    }

    function expenseWaiver() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'voucherWaiverManagerConfirmed','voucherNotRequired','voucherRequirementWaived','amountConfirmedByManagerWaiver'
        ])
        && manager() && resource.data.get('deleted', false) != true
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'voucherWaiverManagerConfirmed','voucherWaiverManagerConfirmedBy','voucherWaiverManagerConfirmedAt',
          'voucherNotRequired','voucherRequirementWaived','amountConfirmed','amountConfirmedByManagerWaiver','updatedAt','updatedBy'
        ])
        && (
          (!recordLocked() && !hasVoucher(resource.data)
            && request.resource.data.voucherWaiverManagerConfirmed == true
            && request.resource.data.voucherWaiverManagerConfirmedBy == email()
            && request.resource.data.voucherWaiverManagerConfirmedAt == request.time
            && request.resource.data.voucherNotRequired == true
            && request.resource.data.voucherRequirementWaived == true
            && request.resource.data.amountConfirmed == true
            && request.resource.data.amountConfirmedByManagerWaiver == true)
          || (request.resource.data.voucherWaiverManagerConfirmed == false
            && request.resource.data.voucherWaiverManagerConfirmedBy == ''
            && request.resource.data.voucherWaiverManagerConfirmedAt == null
            && request.resource.data.voucherNotRequired == false
            && request.resource.data.voucherRequirementWaived == false
            && request.resource.data.amountConfirmed == false
            && request.resource.data.amountConfirmedByManagerWaiver == false)
        );
    }

    function expenseDetach() {
      return (manager() || (enabledUser() && resource.data.ownerEmail == email()))
        && !recordLocked() && resource.data.get('deleted', false) != true
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time
        && request.resource.data.voucherUrl == '' && request.resource.data.folderUrl == ''
        && request.resource.data.voucherPath == '' && request.resource.data.voucherStoragePath == ''
        && request.resource.data.voucherFileName == '' && request.resource.data.voucherFileType == ''
        && request.resource.data.voucherFileSize == 0 && request.resource.data.archived == false
        && request.resource.data.amountConfirmed == false && request.resource.data.amountManuallyConfirmed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'voucherUrl','folderUrl','voucherPath','voucherStoragePath','voucherFileName',
          'voucherFileType','voucherFileSize','archived','amountConfirmed','amountManuallyConfirmed','updatedAt','updatedBy'
        ]);
    }

    function expenseAccountingOwner() {
      return enabledUser() && manager() && linked(resource.data)
        && !recordLocked() && resource.data.get('deleted',false) != true
        && request.resource.data.accountingOwnerEmail is string
        && request.resource.data.accountingOwnerName is string
        && eligibleExpenseOwner(request.resource.data.accountingOwnerEmail)
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountingOwnerEmail','accountingOwnerName','updatedAt','updatedBy'
        ]);
    }

    function expenseOwner() {
      return enabledUser() && manager()
        && !recordLocked() && !linked(resource.data)
        && resource.data.get('deleted', false) != true
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerName is string
        && request.resource.data.ownerEmail != resource.data.get('accountingOwnerEmail', resource.data.ownerEmail)
        && request.resource.data.get('accountingOwnerEmail','') == ''
        && request.resource.data.get('accountingOwnerName','') == ''
        && eligibleExpenseOwner(request.resource.data.ownerEmail)
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerEmail','ownerName','accountingOwnerEmail','accountingOwnerName','updatedAt','updatedBy'
        ]);
    }

    function expenseRecycle() {
      return enabledUser()
        && (manager() || resource.data.ownerEmail == email())
        && !recordLocked() && !linked(resource.data)
        && resource.data.get('deleted', false) != true
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == email()
        && request.resource.data.deletedAt == request.time
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deleted','deletedAt','deletedBy','updatedAt','updatedBy'
        ]);
    }

    function expenseTopUp(recordId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['advanceTopUpTotal']) && managerAdvanceTopUp() && linked(resource.data)
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.expenseRecordId == recordId
        && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.advanceTopUpTotal == request.resource.data.advanceTopUpTotal;
    }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function stamped() {
      return request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == email();
    }
    function expenseRestore() {
      return manager() && resource.data.get('deleted', false) == true
        && request.resource.data.deleted == false && !linked(resource.data)
        && request.resource.data.restoredBy == email() && request.resource.data.restoredAt == request.time
        && request.resource.data.deletedAt == null && request.resource.data.deletedBy == null
        && changed().hasOnly(['deleted','deletedAt','deletedBy','restoredAt','restoredBy','updatedAt','updatedBy']);
    }
    function expensePurge() {
      return manager() && request.resource.data.voucherPurged == true
        && request.resource.data.voucherPurgedAt == request.time && request.resource.data.voucherPurgedBy == email()
        && !hasVoucher(request.resource.data) && request.resource.data.voucherPath == ''
        && request.resource.data.voucherStoragePath == '' && request.resource.data.archived == false
        && changed().hasOnly(['voucherPurged','voucherPurgedAt','voucherPurgedBy','voucherPurgedOriginalPath',
          'voucherPurgedOriginalName','voucherPurgedAction','voucherUrl','folderUrl','voucherPath','voucherStoragePath',
          'archived','updatedAt','updatedBy']);
    }
    function expenseUnlink() {
      return linked(resource.data) && allocationCancellation()
        && request.resource.data.get('advanceBatchId', '') == '' && request.resource.data.advanceLinked == false
        && changed().hasOnly(['advanceAllocationId','advanceBatchId','advanceLinked','updatedAt','updatedBy']);
    }
    function expenseAdjustment() {
      let before=resource.data.get('actualAdjustment',{});
      let after=request.resource.data.get('actualAdjustment',{});
      return (manager() || resource.data.ownerEmail == email()) && !recordLocked()
        && resource.data.get('deleted', false) != true && linked(resource.data)
        && (!changed().hasAny(['actualAdjustmentHistory']) || manager())
        && changed().hasOnly(['amount','estimated','estimateStage','archived','amountConfirmed','amountManuallyConfirmed',
          'reviewStatus','reviewed','locked','actualAdjustment','actualAdjustmentHistory',
          'voucherUrl','voucherPath','voucherStoragePath','voucherFileName','voucherFileSize','voucherFileType','updatedAt','updatedBy'])
        && request.resource.data.get('reviewed',false) != true && request.resource.data.get('locked',false) != true
        && request.resource.data.get('reviewStatus','') != 'approved'
        && (after.get('status','') == 'pending' ? (
          before.get('status','') in ['', 'rejected']
          && after.keys().hasOnly(['status','amount','reason','requestedBy','requestedAt'])
          && after.amount is number && after.amount >= 0
          && after.amount <= get(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.estimatedAmount
          && after.reason is string && after.reason.size() > 0 && after.reason.size() <= 300
          && after.requestedBy == email() && after.requestedAt == request.time
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.estimated == true && amountConfirmed(request.resource.data) && hasVoucher(request.resource.data)
        ) : (
          before.get('status','') == 'pending'
          && after.diff(before).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
          && after.reviewedBy == email() && after.reviewedAt == request.time
          && (after.status == 'approved' ? (
            manager() && request.resource.data.amount == before.amount && request.resource.data.estimated == false
            && getAfter(/databases/$(database)/documents/advanceAllocations/$(resource.data.advanceAllocationId)).data.settlementAmount == before.amount
          ) : (
            after.status == 'rejected' && (manager() || (advanceOfficer() && resource.data.ownerEmail == email()))
            && request.resource.data.amount == resource.data.amount
          ))
        ));
    }
    // Exactly one route is evaluated. Unrelated operations cannot spend this request's rules budget.
    function installmentInitial(d) {
      let s=d.installment;
      return !linked(d) && d.amount is int && d.amount>0 && d.estimated==true
        && s.keys().hasOnly(['enabled','everUsed','closed','total','reviewedTotal','entries','mutationKey'])
        && s.enabled==true && s.everUsed==false && s.closed==false
        && s.total==0 && s.reviewedTotal==0 && s.entries=={} && s.mutationKey=='';
    }
    function installmentEntry(e) {
      return e is map && e.keys().hasOnly(['date','purpose','amount','reimbursementNo','voucher','confirmed','reviewed'])
        && e.date is string && e.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && e.purpose is string && e.purpose.size()>0 && e.purpose.size()<=300
        && e.amount is int && e.amount>0 && e.reimbursementNo is string && e.reimbursementNo.size()<=100
        && e.confirmed==true && e.reviewed is bool
        && e.voucher is map && e.voucher.keys().hasOnly(['url','name','path','type','size'])
        && e.voucher.url is string && e.voucher.url.matches('https://.*')
        && e.voucher.name is string && e.voucher.path is string && e.voucher.type is string
        && e.voucher.size is number && e.voucher.size>=0 && e.voucher.size<=20*1024*1024;
    }
    function installmentMutation(a,b) {
      let key=b.mutationKey;
      let old=a.entries.get(key,{});
      let next=b.entries.get(key,{});
      let removed=next=={};
      let added=old=={};
      return key is string && key.size()>0 && key.size()<=100
        && b.entries.diff(a.entries).affectedKeys().hasOnly([key])
        && b.entries.diff(a.entries).affectedKeys().size()==1
        && (!removed || (!added && old.reviewed==false))
        && (removed || installmentEntry(next))
        && (added ? next.reviewed==false :
          ((old.reviewed==false && (removed || next.reviewed==false))
           || (manager() && !removed && next.diff(old).affectedKeys().hasOnly(['reviewed']))))
        && b.total==a.total-old.get('amount',0)+next.get('amount',0)
        && b.reviewedTotal==a.reviewedTotal-(old.get('reviewed',false)?old.amount:0)+(next.get('reviewed',false)?next.amount:0)
        && b.everUsed==true && b.enabled==true && b.closed==false;
    }
    function installmentUpdate() {
      let a=resource.data.installment;
      let b=request.resource.data.installment;
      return enabledUser() && (manager() || resource.data.ownerEmail==email())
        && !linked(resource.data) && resource.data.get('deleted',false)==false && !recordLocked()
        && a.enabled==true && a.closed==false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['installment','purpose','note','purchaseOrderNo','updatedAt','updatedBy'])
        && b.keys().hasOnly(['enabled','everUsed','closed','total','reviewedTotal','entries','mutationKey'])
        && b.entries is map && b.entries.size()<=150
        && b.total is int && b.total>=0 && b.total<=resource.data.amount
        && b.reviewedTotal is int && b.reviewedTotal>=0 && b.reviewedTotal<=b.total
        && ((a.entries==b.entries && a.total==b.total && a.reviewedTotal==b.reviewedTotal && a.everUsed==b.everUsed
          && ((b.enabled==a.enabled && b.closed==a.closed)
            || (a.everUsed==false && b.enabled==false && b.closed==false)
            || (manager() && b.enabled==true && b.closed==true && b.total==b.reviewedTotal)))
          || installmentMutation(a,b));
    }

    function expenseUpdate(recordId) {
      let k = changed();
      return resource.data.get('installment',{}).get('enabled',false) || k.hasAny(['installment']) ? installmentUpdate()
        : k.hasAny(['advanceAllocationId']) ?
          (linked(request.resource.data) ? linkExistingEstimate(recordId) : expenseUnlink())
        : k.hasAny(['advanceTopUpTotal']) ? expenseTopUp(recordId)
        : k.hasAny(['accountingOwnerEmail','accountingOwnerName','ownerEmail']) ?
          (linked(resource.data) ? expenseAccountingOwner() : expenseOwner())
        : k.hasAny(['voucherNotRequired','voucherRequirementWaived','amountConfirmedByManagerWaiver',
            'voucherWaiverManagerConfirmed','voucherWaiverManagerConfirmedAt','voucherWaiverManagerConfirmedBy']) ? expenseWaiver()
        : k.hasAny(['deleted','restoredAt','restoredBy']) ?
          (request.resource.data.get('deleted', false) ? expenseRecycle() : expenseRestore())
        : k.hasAny(['voucherPurged','voucherPurgedAt','voucherPurgedBy']) ? expensePurge()
        : k.hasAny(['reviewedAt','reviewedBy','unlockedAt','unlockedBy'])
            || (k.hasAny(['reviewStatus','locked','reviewed']) && (request.resource.data.get('reviewStatus', '') == 'approved'
            || request.resource.data.get('locked', false) || request.resource.data.get('reviewed', false))) ? expenseReview()
        : k.hasAny(['refundAdjustment']) ? expenseRefund()
        : k.hasAny(['actualAdjustment','actualAdjustmentHistory']) ? expenseAdjustment()
        : linked(resource.data) && k.hasAny(['amount']) ? expenseRefund()
        : k.hasAny(['voucherNotRequiredRequested','voucherNotRequiredRequestedAt','voucherNotRequiredRequestedBy']) ? expenseWaiverRequest()
        : k.hasOnly(['purpose','note','purchaseOrderNo','reimbursementNo','amount','updatedAt','updatedBy']) ? expenseCorrection()
        : k.hasAny(['folderUrl','amountManuallyConfirmed']) && !hasVoucher(request.resource.data) ? expenseDetach()
        : expenseForm();
    }

    match /expenseRecords/{recordId} {
      allow read: if enabledUser();
      allow create: if enabledUser()
        && (!request.resource.data.keys().hasAny(['installment']) || installmentInitial(request.resource.data))
        && !request.resource.data.keys().hasAny(['accountingVoucherAmount','advanceTopUpTotal','accountingOwnerEmail','accountingOwnerName'])
        && request.resource.data.get('reviewStatus', 'pending') != 'approved'
        && request.resource.data.get('reviewed', false) != true
        && request.resource.data.get('locked', false) != true
        && (
          (
            manager()
            && request.resource.data.createdBy == email()
            && submissionComplete(request.resource.data)
          )
          || (
            !manager()
            && request.resource.data.ownerEmail == email()
            && request.resource.data.createdBy == email()
            && !voucherWaived(request.resource.data)
            && submissionComplete(request.resource.data)
          )
        );
      allow update: if enabledUser() && stamped() && expenseUpdate(recordId);
      allow delete: if enabledUser() && !resource.data.get('installment',{}).get('everUsed',false) && !resource.data.get('installment',{}).get('closed',false) && !linked(resource.data) && (
        manager()
        || (
          resource.data.ownerEmail == email()
          && !recordLocked()
        )
      );
    }

    match /auditLogs/{logId} {
      allow read: if manager();
      allow create: if manager() || (advanceOfficer()
        && request.resource.data.actorEmail == email()
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.type in ['advance-batch','advance-receipt']
            && ownBatch(getAfter(/databases/$(database)/documents/advanceBatches/$(request.resource.data.targetId)).data))
          || (request.resource.data.type == 'advance-allocation'
            && ownAllocation(getAfter(/databases/$(database)/documents/advanceAllocations/$(request.resource.data.targetId)).data))));
      allow update, delete: if false;
    }
  }
}


